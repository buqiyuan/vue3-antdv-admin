# Copy to .env / .env.development / .env.production. Do not commit secrets.

# Browser tab title
VITE_APP_TITLE=Admin

# Public base path (Vite `base`)
VITE_BASE_URL=/

# Axios base URL. Development uses the Vite proxy (`/api` is stripped, Nest global prefix remains).
VITE_BASE_API_URL=/api

# Where `vp dev` proxies `/api` (Nest Admin). Not read by production builds.
VITE_API_PROXY_TARGET=http://127.0.0.1:7001

# Drop console.log in production builds
VITE_DROP_CONSOLE=false
