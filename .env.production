# 只在生产模式中被载入
ENV = 'production'

# Public demo API. Fallback origin if this proxy is down: http://45.32.250.83
# Unquoted on purpose. Vite lets a host env var override this file, and a blank
# VITE_BASE_API_URL would wipe it. The build ignores a blank override. If a
# production build still has no origin, the client falls back to this demo API.
VITE_BASE_API_URL=https://nest-admin-api.pages.dev

# 公共基础路径, 详见: https://cn.vitejs.dev/guide/build.html#public-base-path
VITE_BASE_URL = /vue3-antdv-admin/

VITE_DROP_CONSOLE = true
