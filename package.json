{
  "name": "vue3-antdv-admin",
  "type": "module",
  "version": "2.0.0",
  "packageManager": "pnpm@10.10.0",
  "author": {
    "name": "buqiyuan",
    "email": "1743369777@qq.com",
    "url": "https://github.com/buqiyuan"
  },
  "license": "MIT",
  "homepage": "https://buqiyuan.gitee.io/vue3-antdv-admin",
  "repository": {
    "type": "git",
    "url": "https://github.com/buqiyuan/vue3-antdv-admin"
  },
  "keywords": [
    "vue",
    "ant-design-vue",
    "vue3",
    "ts",
    "tsx",
    "admin",
    "typescript"
  ],
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "postinstall": "pnpm build:plugins",
    "bootstrap": "pnpm install",
    "serve": "npm run dev",
    "dev": "vp dev",
    "build": "rimraf dist && cross-env NODE_ENV=production vp build",
    "build:watch": "rimraf dist && cross-env NODE_ENV=production vp build --watch",
    "build:pkg": "pnpm -r --filter=\"./packages/*\" run build",
    "build:plugins": "pnpm --filter @admin-pkg/vite-plugin-http2-proxy --filter @admin-pkg/vite-plugin-tinymce-resource --filter @admin-pkg/vite-plugin-msw run build",
    "typecheck": "vue-tsc --noEmit --pretty false",
    "preview": "npm run build --watch && vp preview",
    "preview:dist": "vp preview",
    "openapi": "vpx openapi.config.ts",
    "clean:cache": "npx rimraf node_modules/.cache/ && npx rimraf node_modules/.vite",
    "clean:lib": "npx rimraf node_modules packages/*/node_modules",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "lint:lint-staged": "lint-staged",
    "prepare": "husky",
    "release": "git push && git push origin --tags",
    "gen:changelog": "conventional-changelog -p angular -i CHANGELOG.md -s && git add CHANGELOG.md",
    "reinstall": "rimraf pnpm-lock.yaml && rimraf package.lock.json && pnpm clean:lib && npm run bootstrap",
    "test:gzip": "npx http-server dist --cors --gzip -c-1",
    "test:br": "npx http-server dist --cors --brotli -c-1"
  },
  "dependencies": {
    "@ant-design/icons-vue": "~7.0.1",
    "@iconify/vue": "^5.0.4",
    "@tinymce/tinymce-vue": "^6.3.0",
    "@vueuse/core": "^15.0.0",
    "ant-design-vue": "~4.2.6",
    "axios": "^1.20.0",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "file-saver": "~2.0.5",
    "lodash-es": "^4.18.1",
    "mitt": "~3.0.1",
    "nprogress": "~1.0.0-1",
    "pinia": "~4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "qiniu-js": "^3.4.4",
    "qs": "^6.16.1",
    "sortablejs": "^1.15.7",
    "tinymce": "^8.10.0",
    "vue": "~3.5.44",
    "vue-echarts": "^8.3.2",
    "vue-i18n": "^11.4.16",
    "vue-router": "~5.4.0",
    "vue-types": "^7.0.1",
    "vue-virtual-scroller": "^3.0.5",
    "xlsx": "~0.18.5"
  },
  "devDependencies": {
    "@admin-pkg/components": "workspace:*",
    "@admin-pkg/vite-plugin-http2-proxy": "workspace:*",
    "@admin-pkg/vite-plugin-msw": "workspace:*",
    "@admin-pkg/vite-plugin-tinymce-resource": "workspace:*",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@faker-js/faker": "^10.6.0",
    "@iconify-json/ant-design": "^1.2.5",
    "@iconify-json/ep": "^1.2.2",
    "@iconify/json": "^2.2.339",
    "@types/crypto-js": "^4.2.2",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "~22.20.5",
    "@types/qs": "^6.14.0",
    "@types/sortablejs": "^1.15.8",
    "@umijs/openapi": "^1.14.1",
    "@vitejs/plugin-vue": "~6.0.10",
    "@vitejs/plugin-vue-jsx": "~5.1.6",
    "@vue/tsconfig": "^0.9.1",
    "commitizen": "^4.3.2",
    "conventional-changelog-cli": "^5.0.0",
    "core-js": "^3.42.0",
    "cross-env": "^10.1.0",
    "husky": "~9.1.7",
    "less": "^4.9.1",
    "lint-staged": "^17.6.0",
    "msw": "^2.15.0",
    "rimraf": "^6.1.3",
    "typescript": "catalog:",
    "unocss": "^66.12.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "catalog:",
    "vite-plugin-mkcert": "^2.1.0",
    "vite-plugin-svg-icons": "~2.0.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "~3.3.13",
    "vite-plus": "catalog:"
  },
  "target": "web"
}
